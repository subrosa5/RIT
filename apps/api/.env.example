# Copy to .env for local development. Never commit the real .env file
# (it's in .gitignore) — this file only documents the shape.

ENVIRONMENT=development

# SQLite is fine for local dev/tests; docker-compose points this at Postgres.
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Generate a real one for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
COOKIE_SECURE=false

CORS_ORIGINS=["http://localhost:5173"]

# Optional — falls back to a deterministic heuristic scorer without this.
ANTHROPIC_API_KEY=

# Optional — the daily digest script prints to stdout without these.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
